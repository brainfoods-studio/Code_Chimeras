+# Edit applied: refunds can now be filtered by reason, so reason_code was added.
+# It used to be: def build_refunds_report(year: int = 2026) -> dict:
+def build_refunds_report(year: int = 2026, *, reason_code: str) -> dict:
+    rows = [row for row in REFUNDS if row["reason_code"] == reason_code]
+    total = sum(row["amount_cents"] for row in rows)
+    return {"report": "refunds", "year": year, "reason_code": reason_code, "total_cents": total}
 
 
