diff --git a/pre/exporters/csv_exporter.py b/before/exporters/csv_exporter.py
index e95269c..2b3b36a 100644
--- a/pre/exporters/csv_exporter.py
+++ b/before/exporters/csv_exporter.py
@@ -5,10 +5,12 @@ from exporters.base import Exporter
 
 
 class CsvExporter(Exporter, key="csv"):
-    def export(self, rows):
+    # Edit applied: encoding was added so one customer can get latin-1 files.
+    # It used to be: def export(self, rows):
+    def export(self, rows, *, encoding):
         out = io.StringIO()
         if rows:
             writer = csv.DictWriter(out, fieldnames=list(rows[0]))
             writer.writeheader()
             writer.writerows(rows)
-        return out.getvalue().encode("utf-8")
+        return out.getvalue().encode(encoding)
